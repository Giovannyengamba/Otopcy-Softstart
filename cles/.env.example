# ─────────────────────────────────────────────────────────────────────────
# Otopcy SoftStart — modèle de configuration
#
# Copier en `.env.local`, puis remplir le bloc 1. Tout le reste est
# optionnel : un prestataire sans clé est inerte, pas fatal.
#
# ⚠️  AJOUTER `.env*` AU .gitignore AVANT LE PREMIER COMMIT.
#     Un .env commité une fois reste dans l'historique, et toutes les clés
#     qu'il contenait sont à révoquer.
#
# Toutes les valeurs ci-dessous sont FACTICES.
# ─────────────────────────────────────────────────────────────────────────

# ── 1. Obligatoire ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/base?sslmode=require"
JWT_SECRET="remplacer-par-la-sortie-de-openssl-rand-base64-48"
COOKIE_PREFIX="monapp"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 2. Infrastructure ────────────────────────────────────────────────────
# Absent → limitation de débit en mémoire (par instance : insuffisant en prod)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Obligatoire dès qu'il existe une tâche planifiée
CRON_SECRET=""

SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── 3. E-mail ────────────────────────────────────────────────────────────
# Le domaine doit être VÉRIFIÉ chez le prestataire, sinon rien ne part
RESEND_API_KEY=""
EMAIL_FROM="Mon App <bonjour@exemple.com>"
EMAIL_JOB_RETENTION_DAYS="30"

# ── 4. Stockage de fichiers ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp,application/pdf"
UPLOAD_MAX_BYTES="10485760"

# ── 5. Connexion Google ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"

# ── 6. Paiements ─────────────────────────────────────────────────────────
# ⚠️ « charge » et « payout » sont DEUX clés distinctes. Ne pas les confondre.
# ⚠️ Le secret de webhook n'est pas optionnel : sans lui, n'importe qui peut
#    déclarer une commande payée.
PAYMENT_CHARGE_KEY=""
PAYMENT_PAYOUT_KEY=""
PAYMENT_WEBHOOK_SECRET=""

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

WITHDRAWAL_BALANCE_CHECK="1"   # 0 = désactivé. Risque financier réel.

# ── 7. Mesure d'audience ─────────────────────────────────────────────────
# NEXT_PUBLIC_* = LISIBLE PAR TOUT LE MONDE. Jamais de secret ici.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""

# Chargés seulement après consentement
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""

# ── 8. Développement ─────────────────────────────────────────────────────
# Simule un pays visiteur en local (l'en-tête géo n'existe qu'en production)
DEV_PAYS=""
